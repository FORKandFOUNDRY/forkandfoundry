function renderCB(){
  const content=document.getElementById('cb-content');
  const empty=document.getElementById('cb-empty');
  const filtered=cbCat==='all'?cbData:cbData.filter(d=>d.id===cbCat);
  let html='';let total=0;
  filtered.forEach(cat=>{
    const comments=cat.comments.filter(c=>!cbQ||c.text.toLowerCase().includes(cbQ)||c.tone.toLowerCase().includes(cbQ));
    if(!comments.length)return;
    total+=comments.length;
    if(cbCat==='all')html+=`<div style="font-family:'Cormorant Garamond',serif;font-size:16px;font-weight:600;color:var(--cream);margin:16px 0 8px">${cat.icon} ${cat.label}</div>`;
    comments.forEach((c,i)=>{
      const id=cat.id+'-'+i;
      html+=`<div class="comment-card-item" onclick="copyCB('${id}',this)"><div class="cc-text">${esc(c.text)}</div><div class="cc-footer"><span class="cc-tone">${esc(c.tone)}</span><span class="cc-copy">⎘ Tap to copy</span></div></div>`;
    });
  });
  content.innerHTML=html;
  empty.style.display=total===0?'block':'none';
