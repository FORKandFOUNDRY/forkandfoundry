<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Fork & Foundry — Forged in Service</title>
<meta name="description" content="Free tools, resources, and real talk for kitchen operators and professional cooks. Fork & Foundry — Forged in Service."/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=Fira+Code:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
:root {
  --forge:  #141210;
  --iron:   #1e1914;
  --slag:   #2a2318;
  --border: #352d22;
  --ember:  #c4622a;
  --flame:  #e07840;
  --gold:   #c8963c;
  --ash:    #a89070;
  --smoke:  #655848;
  --linen:  #ede4d4;
  --cream:  #f8f0e0;
  --green:  #4a9a6a;
  --yellow: #c8a030;
  --red:    #b84040;
  --r: 2px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--forge);color:var(--linen);font-family:'Fira Code',monospace;min-height:100vh;overflow-x:hidden;padding-bottom:70px;}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;opacity:0.03;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");background-size:160px;}

/* ── PAGES ── */
.page{display:none;min-height:calc(100vh - 70px);animation:fadeUp 0.3s ease;}
.page.active{display:block;}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}

/* ── GLOBAL NAV ── */
.gnav{position:fixed;bottom:0;left:0;right:0;z-index:500;background:var(--iron);border-top:1px solid var(--border);display:flex;padding-bottom:env(safe-area-inset-bottom,0);}
.gnav-btn{flex:1;padding:10px 2px 8px;background:none;border:none;color:var(--smoke);font-family:'Fira Code',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;transition:color 0.2s;display:flex;flex-direction:column;align-items:center;gap:3px;}
.gnav-icon{font-size:16px;line-height:1;}
.gnav-btn:hover{color:var(--ash);}
.gnav-btn.active{color:var(--flame);}

/* ── PAGE HEADER ── */
.page-hdr{background:linear-gradient(180deg,#1e1610 0%,var(--forge) 100%);border-bottom:1px solid var(--border);padding:36px 20px 26px;text-align:center;position:relative;overflow:hidden;}
.page-hdr::after{content:'';position:absolute;bottom:-80px;left:50%;transform:translateX(-50%);width:480px;height:200px;background:radial-gradient(ellipse,rgba(196,98,42,0.15) 0%,transparent 70%);pointer-events:none;}
.hdr-rule{display:flex;align-items:center;gap:10px;justify-content:center;margin-bottom:8px;}
.hdr-line{flex:1;max-width:40px;height:1px;background:linear-gradient(90deg,transparent,var(--ember));}
.hdr-line.r{background:linear-gradient(90deg,var(--ember),transparent);}
.brand{font-family:'Cormorant Garamond',serif;font-size:clamp(28px,7vw,42px);font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#fff;text-shadow:0 2px 20px rgba(0,0,0,0.9);line-height:1;}
.brand-sub{font-size:9px;letter-spacing:0.26em;text-transform:uppercase;color:var(--ember);margin-top:5px;}
.hdr-desc{font-size:10px;color:var(--smoke);margin-top:5px;letter-spacing:0.04em;line-height:1.6;}

/* ── TOOL TABS ── */
.tool-tabs{display:flex;border-bottom:1px solid var(--border);background:var(--iron);overflow-x:auto;scrollbar-width:none;position:sticky;top:0;z-index:10;}
.tool-tabs::-webkit-scrollbar{display:none;}
.ttab{flex-shrink:0;padding:13px 16px;font-family:'Fira Code',monospace;font-size:9px;letter-spacing:0.16em;text-transform:uppercase;color:var(--smoke);background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;transition:color 0.2s;position:relative;}
.ttab::after{content:'';position:absolute;bottom:-1px;left:0;right:0;height:2px;background:var(--ember);transform:scaleX(0);transition:transform 0.25s ease;}
.ttab:hover{color:var(--ash);}
.ttab.active{color:var(--flame);}
.ttab.active::after{transform:scaleX(1);}

/* ── PANELS ── */
.tpanels{padding:20px 16px 20px;max-width:640px;margin:0 auto;}
.tpanel{display:none;animation:fadeUp 0.3s ease;}
.tpanel.active{display:block;}

/* ── CARD ── */
.card{background:var(--iron);border:1px solid var(--border);border-radius:var(--r);padding:20px 18px;margin-bottom:14px;position:relative;overflow:hidden;}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--ember),transparent 55%);}
.card-hd{display:flex;align-items:baseline;gap:10px;margin-bottom:4px;}
.card-num{font-family:'Cormorant Garamond',serif;font-size:11px;color:var(--ember);letter-spacing:0.1em;}
.card-title{font-family:'Cormorant Garamond',serif;font-size:19px;font-weight:600;color:var(--cream);}
.card-desc{font-size:10px;color:var(--smoke);margin-bottom:16px;line-height:1.7;letter-spacing:0.04em;}

/* ── FORM ── */
label{display:block;font-size:9px;letter-spacing:0.18em;text-transform:uppercase;color:var(--ash);margin-bottom:5px;margin-top:13px;}
label:first-of-type{margin-top:0;}
input[type="number"],input[type="text"],input[type="time"],select,textarea{width:100%;background:var(--forge);border:1px solid var(--border);color:var(--linen);font-family:'Fira Code',monospace;font-size:13px;padding:10px 12px;border-radius:var(--r);appearance:none;outline:none;transition:border-color 0.2s,box-shadow 0.2s;}
input:focus,select:focus,textarea:focus{border-color:var(--ember);box-shadow:0 0 0 3px rgba(196,98,42,0.1);}
textarea{resize:vertical;min-height:80px;}
select option{background:#1e1914;}
.row-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;}

/* ── INGREDIENT ROW ── */
.ing-row{display:grid;grid-template-columns:1fr 80px 68px 28px;gap:6px;align-items:center;margin-bottom:7px;}
.ing-row input{font-size:12px;padding:8px 10px;}
.del-btn{background:none;border:1px solid var(--border);color:var(--smoke);cursor:pointer;font-size:14px;border-radius:var(--r);width:28px;height:34px;display:flex;align-items:center;justify-content:center;transition:all 0.2s;flex-shrink:0;}
.del-btn:hover{border-color:var(--ember);color:var(--ember);}

/* ── PREP / WASTE ROWS ── */
.prep-row{display:grid;grid-template-columns:1fr 90px 90px 28px;gap:6px;align-items:center;margin-bottom:7px;}
.prep-row input{font-size:12px;padding:8px 10px;}
.waste-row{display:grid;grid-template-columns:1fr 80px 80px 28px;gap:6px;align-items:center;margin-bottom:7px;}
.waste-row input{font-size:12px;padding:8px 10px;}

/* ── STAFF ROWS ── */
.staff-row{display:grid;grid-template-columns:1fr 80px 28px;gap:6px;align-items:center;margin-bottom:7px;}
.staff-row input{font-size:12px;padding:8px 10px;}

/* ── BUTTONS ── */
.btn{margin-top:16px;width:100%;padding:13px;background:var(--ember);color:var(--forge);font-family:'Fira Code',monospace;font-size:10px;letter-spacing:0.2em;text-transform:uppercase;font-weight:500;border:none;border-radius:var(--r);cursor:pointer;transition:background 0.2s,transform 0.1s;}
.btn:hover{background:var(--flame);}
.btn:active{transform:scale(0.99);}
.btn-ghost{background:transparent;border:1px solid var(--border);color:var(--smoke);margin-top:8px;}
.btn-ghost:hover{border-color:var(--ember);color:var(--ash);background:transparent;}
.btn-sm{padding:8px;font-size:9px;margin-top:8px;}
.btn-danger{background:var(--red);color:#fff;}
.btn-danger:hover{background:#c84848;}
.btn-print{background:var(--iron);border:1px solid var(--ember);color:var(--flame);}
.btn-print:hover{background:rgba(196,98,42,0.1);}

/* ── RESULTS ── */
.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px;}
.result-box{background:var(--forge);border:1px solid var(--border);border-radius:var(--r);padding:14px;text-align:center;transition:border-color 0.3s;}
.result-box.hl{border-color:var(--ember);}
.rb-label{font-size:8px;letter-spacing:0.18em;text-transform:uppercase;color:var(--smoke);margin-bottom:6px;}
.rb-val{font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:700;color:var(--cream);line-height:1;}
.rb-val.c-good{color:var(--green);}
.rb-val.c-warn{color:var(--yellow);}
.rb-val.c-bad{color:var(--red);}
.rb-sub{font-size:9px;color:var(--smoke);margin-top:4px;}

.verdict{margin-top:10px;padding:13px 15px;border-radius:var(--r);border:1px solid;display:none;animation:fadeUp 0.3s ease;}
.verdict.show{display:block;}
.verdict.v-good{border-color:var(--green);background:rgba(74,154,106,0.08);}
.verdict.v-warn{border-color:var(--yellow);background:rgba(200,160,48,0.08);}
.verdict.v-bad{border-color:var(--red);background:rgba(184,64,64,0.08);}
.verdict-lbl{font-size:8px;letter-spacing:0.18em;text-transform:uppercase;margin-bottom:5px;}
.verdict.v-good .verdict-lbl{color:var(--green);}
.verdict.v-warn .verdict-lbl{color:var(--yellow);}
.verdict.v-bad .verdict-lbl{color:var(--red);}
.verdict-txt{font-size:11px;color:var(--ash);line-height:1.6;}

/* ── TABLE ── */
.dt{width:100%;border-collapse:collapse;margin-top:10px;}
.dt th{font-size:8px;letter-spacing:0.16em;text-transform:uppercase;color:var(--smoke);text-align:left;padding:6px 8px;border-bottom:1px solid var(--border);}
.dt td{font-size:12px;padding:8px;border-bottom:1px solid rgba(53,45,34,0.5);color:var(--linen);}
.dt td.r{text-align:right;}
.dt td.ac{color:var(--flame);}
.dt td.good{color:var(--green);}
.dt td.warn{color:var(--yellow);}
.dt td.bad{color:var(--red);}
.dt tr:last-child td{border-bottom:none;}

/* ── DIVIDER ── */
.div{height:1px;background:linear-gradient(90deg,transparent,var(--border),transparent);margin:15px 0;position:relative;}
.div-lbl{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:var(--iron);padding:0 10px;font-size:8px;letter-spacing:0.18em;text-transform:uppercase;color:var(--smoke);}

/* ── GAUGE ── */
.gauge-wrap{margin-top:12px;}
.gauge-row{display:flex;justify-content:space-between;margin-bottom:5px;}
.gauge-lbl{font-size:9px;color:var(--smoke);}
.gauge-val{font-size:9px;color:var(--ash);}
.gauge-track{height:6px;background:var(--forge);border-radius:3px;border:1px solid var(--border);overflow:hidden;}
.gauge-fill{height:100%;width:0%;border-radius:3px;transition:width 0.6s cubic-bezier(0.34,1.56,0.64,1),background 0.3s;}
.gauge-zones{display:flex;justify-content:space-between;margin-top:4px;font-size:7px;color:var(--smoke);}

/* ── PRESET BTNS ── */
.preset-row{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:8px;}
.pbtn{padding:8px 4px;background:var(--forge);border:1px solid var(--border);color:var(--smoke);font-family:'Fira Code',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;border-radius:var(--r);cursor:pointer;transition:all 0.2s;text-align:center;line-height:1.6;}
.pbtn:hover{border-color:var(--ember);color:var(--ash);}
.pbtn.sel{border-color:var(--ember);color:var(--flame);background:rgba(196,98,42,0.1);}

/* ── BADGE ── */
.badge{font-size:8px;letter-spacing:0.14em;text-transform:uppercase;padding:3px 8px;border-radius:1px;flex-shrink:0;}
.badge-free{background:rgba(196,98,42,0.15);color:var(--ember);border:1px solid rgba(196,98,42,0.3);}
.badge-soon{background:rgba(80,80,80,0.2);color:var(--smoke);border:1px solid var(--border);}
.badge-ig{background:rgba(100,80,160,0.15);color:#a090e0;border:1px solid rgba(100,80,160,0.3);}
.badge-new{background:rgba(200,150,60,0.15);color:var(--gold);border:1px solid rgba(200,150,60,0.3);}

/* ── HOME PAGE ── */
.home-wrap{max-width:480px;margin:0 auto;padding:0 18px 20px;position:relative;z-index:1;}
.hero{padding:48px 0 28px;text-align:center;position:relative;}
.hero-glow{position:absolute;top:10px;left:50%;transform:translateX(-50%);width:340px;height:200px;background:radial-gradient(ellipse at 50% 30%,rgba(196,98,42,0.14) 0%,transparent 70%);pointer-events:none;}
.anvil{display:inline-flex;align-items:center;justify-content:center;width:60px;height:60px;border:1px solid var(--border);border-radius:50%;margin-bottom:16px;background:var(--iron);position:relative;}
.anvil::before{content:'';position:absolute;inset:-4px;border-radius:50%;border:1px solid rgba(196,98,42,0.2);}
.wordmark{font-family:'Cormorant Garamond',serif;font-size:clamp(34px,10vw,50px);font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#fff;text-shadow:0 2px 20px rgba(0,0,0,0.9);line-height:0.92;}
.wordmark-amp{display:block;font-style:italic;font-weight:300;font-size:0.44em;letter-spacing:0.28em;color:var(--ash);margin:6px 0 4px;}
.tagline{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(14px,4vw,17px);color:var(--ash);margin-top:10px;}
.hero-handle{margin-top:7px;font-size:10px;letter-spacing:0.2em;color:var(--smoke);}
.hero-handle a{color:var(--ember);text-decoration:none;}

.manifesto{margin:20px 0;border:1px solid var(--border);border-radius:var(--r);padding:20px 18px;background:var(--iron);position:relative;overflow:hidden;}
.manifesto::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--ember),var(--gold),transparent 70%);}
.mani-eye{font-size:8px;letter-spacing:0.26em;text-transform:uppercase;color:var(--ember);margin-bottom:10px;}
.mani-text{font-family:'Cormorant Garamond',serif;font-size:clamp(16px,5vw,20px);font-weight:600;line-height:1.4;color:var(--cream);}
.mani-text em{font-style:italic;color:var(--flame);}
.mani-sub{font-size:10px;color:var(--smoke);margin-top:10px;line-height:1.7;letter-spacing:0.03em;}

.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:0 0 20px;}
.stat-box{background:var(--iron);border:1px solid var(--border);border-radius:var(--r);padding:12px 8px;text-align:center;}
.stat-val{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:700;color:var(--cream);line-height:1;}
.stat-lbl{font-size:7px;letter-spacing:0.12em;text-transform:uppercase;color:var(--smoke);margin-top:4px;line-height:1.4;}

.sec-div{display:flex;align-items:center;gap:12px;margin:22px 0 14px;}
.sec-line{flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--border));}
.sec-line.r{background:linear-gradient(90deg,var(--border),transparent);}
.sec-lbl{font-size:8px;letter-spacing:0.26em;text-transform:uppercase;color:var(--smoke);white-space:nowrap;}

.lcard{display:flex;align-items:center;gap:12px;background:var(--iron);border:1px solid var(--border);border-radius:var(--r);padding:14px 15px;text-decoration:none;color:var(--linen);transition:border-color 0.2s,background 0.2s,transform 0.15s;position:relative;overflow:hidden;margin-bottom:8px;cursor:pointer;-webkit-tap-highlight-color:transparent;}
.lcard::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,var(--ember),transparent 55%);opacity:0;transition:opacity 0.2s;}
.lcard:hover{border-color:var(--ember);background:rgba(196,98,42,0.05);transform:translateY(-1px);}
.lcard:hover::before{opacity:1;}
.lcard:active{transform:scale(0.99);}
.lcard-icon{width:36px;height:36px;flex-shrink:0;border:1px solid var(--border);border-radius:var(--r);display:flex;align-items:center;justify-content:center;font-size:16px;background:var(--forge);}
.lcard-body{flex:1;min-width:0;}
.lcard-title{font-family:'Cormorant Garamond',serif;font-size:15px;font-weight:600;color:var(--cream);display:block;}
.lcard-desc{font-size:9px;letter-spacing:0.06em;color:var(--smoke);margin-top:2px;display:block;line-height:1.5;}
.lcard-arrow{font-size:13px;color:var(--smoke);flex-shrink:0;transition:color 0.2s,transform 0.2s;}
.lcard:hover .lcard-arrow{color:var(--ember);transform:translateX(2px);}
.lcard.disabled{opacity:0.5;pointer-events:none;}

/* ── ABOUT ── */
.about-wrap{max-width:580px;margin:0 auto;padding:28px 18px 20px;position:relative;z-index:1;}
.about-section{margin-bottom:28px;}
.about-section h2{font-family:'Cormorant Garamond',serif;font-size:clamp(22px,6vw,30px);font-weight:600;color:var(--cream);margin-bottom:12px;letter-spacing:0.02em;}
.about-section h2 em{font-style:italic;color:var(--flame);}
.about-section p{font-size:11px;color:var(--ash);line-height:1.9;letter-spacing:0.04em;margin-bottom:10px;}
.about-section p strong{color:var(--linen);font-weight:500;}
.pillar-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px;}
.pillar{background:var(--iron);border:1px solid var(--border);border-radius:var(--r);padding:16px;position:relative;overflow:hidden;}
.pillar::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--ember),transparent);}
.pillar-icon{font-size:22px;margin-bottom:8px;}
.pillar-title{font-family:'Cormorant Garamond',serif;font-size:16px;font-weight:600;color:var(--cream);margin-bottom:4px;}
.pillar-desc{font-size:9px;color:var(--smoke);line-height:1.6;letter-spacing:0.04em;}
.big-quote{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(20px,5vw,26px);color:var(--cream);line-height:1.4;border-left:3px solid var(--ember);padding-left:18px;margin:20px 0;}
.team-note{background:var(--iron);border:1px solid var(--border);border-radius:var(--r);padding:18px;margin-top:16px;}
.team-note-title{font-family:'Cormorant Garamond',serif;font-size:16px;color:var(--cream);margin-bottom:8px;}
.team-note-text{font-size:10px;color:var(--smoke);line-height:1.7;letter-spacing:0.04em;}

/* ── BLOG ── */
.blog-wrap{max-width:580px;margin:0 auto;padding:20px 18px;position:relative;z-index:1;}
.blog-card{background:var(--iron);border:1px solid var(--border);border-radius:var(--r);padding:20px 18px;margin-bottom:12px;cursor:pointer;transition:border-color 0.2s,transform 0.15s;position:relative;overflow:hidden;}
.blog-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--ember),transparent 55%);}
.blog-card:hover{border-color:var(--ember);transform:translateY(-1px);}
.blog-tag{font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:var(--ember);margin-bottom:8px;}
.blog-title{font-family:'Cormorant Garamond',serif;font-size:clamp(18px,5vw,22px);font-weight:600;color:var(--cream);line-height:1.3;margin-bottom:8px;}
.blog-excerpt{font-size:10px;color:var(--smoke);line-height:1.7;letter-spacing:0.03em;margin-bottom:12px;}
.blog-meta{display:flex;align-items:center;justify-content:space-between;}
.blog-date{font-size:8px;letter-spacing:0.12em;color:var(--smoke);}
.blog-read{font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ember);}

/* ── POST ── */
.post-wrap{max-width:580px;margin:0 auto;padding:20px 18px;position:relative;z-index:1;display:none;}
.post-wrap.active{display:block;}
.post-back{display:flex;align-items:center;gap:8px;font-size:9px;letter-spacing:0.16em;text-transform:uppercase;color:var(--smoke);cursor:pointer;margin-bottom:20px;transition:color 0.2s;}
.post-back:hover{color:var(--ember);}
.post-tag{font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:var(--ember);margin-bottom:10px;}
.post-title{font-family:'Cormorant Garamond',serif;font-size:clamp(24px,7vw,34px);font-weight:700;color:var(--cream);line-height:1.2;margin-bottom:10px;}
.post-meta{font-size:8px;letter-spacing:0.12em;color:var(--smoke);margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--border);}
.post-body p{font-size:11px;color:var(--ash);line-height:1.9;letter-spacing:0.04em;margin-bottom:14px;}
.post-body p strong{color:var(--linen);font-weight:500;}
.post-body h3{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:600;color:var(--cream);margin:20px 0 8px;}
.post-body blockquote{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:16px;color:var(--cream);border-left:3px solid var(--ember);padding-left:16px;margin:16px 0;line-height:1.5;}
.post-body ul{margin:10px 0 14px 0;padding-left:0;list-style:none;}
.post-body ul li{font-size:11px;color:var(--ash);line-height:1.8;letter-spacing:0.04em;padding-left:16px;position:relative;}
.post-body ul li::before{content:'—';position:absolute;left:0;color:var(--ember);}

/* ── COMMENT BANK ── */
.cbank-wrap{max-width:620px;margin:0 auto;padding:14px 16px 20px;position:relative;z-index:1;}
.comment-card-item{background:var(--iron);border:1px solid var(--border);border-radius:var(--r);padding:13px 15px;margin-bottom:8px;cursor:pointer;transition:border-color 0.2s;}
.comment-card-item:hover{border-color:var(--ember);}
.cc-text{font-size:12px;line-height:1.7;color:var(--linen);}
.cc-footer{display:flex;justify-content:space-between;align-items:center;margin-top:8px;}
.cc-tone{font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:var(--smoke);border:1px solid var(--border);padding:3px 7px;border-radius:1px;}
.cc-copy{font-size:9px;color:var(--smoke);}

/* ── PRINT PREP LIST ── */
.print-list{display:none;}
@media print{
  .gnav,.page-hdr,.tool-tabs,.btn,.card::before{display:none!important;}
  body{background:#fff;color:#000;padding:0;}
  .print-list{display:block;}
  .no-print{display:none!important;}
}

/* ── TOAST ── */
#toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(100px);background:var(--ember);color:var(--forge);font-family:'Fira Code',monospace;font-size:10px;letter-spacing:0.18em;text-transform:uppercase;padding:10px 20px;border-radius:var(--r);transition:transform 0.3s cubic-bezier(0.34,1.56,0.64,1);z-index:600;white-space:nowrap;pointer-events:none;}
#toast.show{transform:translateX(-50%) translateY(0);}

/* ── SITE FOOTER ── */
.site-footer{text-align:center;padding:20px;border-top:1px solid var(--border);font-size:9px;letter-spacing:0.14em;color:var(--smoke);}
.site-footer a{color:var(--ember);text-decoration:none;}
.sf-brand{font-family:'Cormorant Garamond',serif;font-size:13px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:var(--ash);display:block;margin-bottom:4px;}
.sf-motto{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:12px;color:var(--smoke);display:block;}

@media(max-width:400px){
  .ing-row{grid-template-columns:1fr 68px 60px 24px;gap:5px;}
  .prep-row{grid-template-columns:1fr 76px 76px 24px;gap:5px;}
  .waste-row{grid-template-columns:1fr 70px 70px 24px;gap:5px;}
  .staff-row{grid-template-columns:1fr 70px 24px;gap:5px;}
  .result-grid{grid-template-columns:1fr;}
  .row-2{grid-template-columns:1fr;}
  .stats{grid-template-columns:repeat(2,1fr);}
  .pillar-grid{grid-template-columns:1fr;}
}
</style>
</head>
