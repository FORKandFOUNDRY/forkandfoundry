<!-- ══════════════════════════════════════════════
  KITCHEN TOOLKIT
══════════════════════════════════════════════ -->
<div class="page" id="page-tools">
  <div class="page-hdr">
    <div class="hdr-rule"><div class="hdr-line"></div><span style="color:var(--ember);font-size:13px">🍴</span><div class="hdr-line r"></div></div>
    <div class="brand">Kitchen Toolkit</div>
    <div class="brand-sub">Fork &amp; Foundry</div>
  </div>
  <div class="tool-tabs">
    <button class="ttab active" onclick="tt('convert',this,'tools')">Convert</button>
    <button class="ttab" onclick="tt('bakers',this,'tools')">Baker's %</button>
    <button class="ttab" onclick="tt('scale',this,'tools')">Scale</button>
    <button class="ttab" onclick="tt('temp',this,'tools')">Temp</button>
  </div>
  <div class="tpanels">

    <div class="tpanel active" id="tp-convert">
      <div class="card">
        <div class="card-hd"><span class="card-num">01</span><span class="card-title">Unit Converter</span></div>
        <div class="card-desc">Weight and volume conversions for the professional kitchen.</div>
        <label>Category</label>
        <select id="conv-cat" onchange="updateConvUnits()"><option value="weight">Weight</option><option value="volume">Volume</option></select>
        <div class="row-2" style="margin-top:12px">
          <div><label>Amount</label><input type="number" id="conv-amt" placeholder="0" step="any"/></div>
          <div><label>From</label><select id="conv-from"></select></div>
        </div>
        <label>To</label><select id="conv-to"></select>
        <button class="btn" onclick="calcConvert()">Convert</button>
        <div id="conv-res" style="display:none">
          <div class="result-grid">
            <div class="result-box hl"><div class="rb-label">Result</div><div class="rb-val" id="conv-out">—</div></div>
            <div class="result-box"><div class="rb-label">Full equation</div><div class="rb-val" style="font-size:13px;padding-top:4px" id="conv-eq">—</div></div>
          </div>
        </div>
      </div>
    </div>

    <div class="tpanel" id="tp-bakers">
      <div class="card">
        <div class="card-hd"><span class="card-num">02</span><span class="card-title">Baker's Percentage</span></div>
        <div class="card-desc">Total flour = 100%. All other ingredients expressed relative to flour weight.</div>
        <label>Flour(s)</label>
        <div id="flour-rows"></div>
        <button class="btn btn-ghost btn-sm" onclick="addFlourRow()">+ Add Flour</button>
        <div class="div"><div class="div-lbl">other ingredients</div></div>
        <div id="bkr-rows"></div>
        <button class="btn btn-ghost btn-sm" onclick="addBkrRow()">+ Add Ingredient</button>
        <button class="btn" style="margin-top:16px" onclick="calcBakers()">Calculate %</button>
        <div id="bkr-res" style="display:none;margin-top:12px"><table class="dt" id="bkr-table"></table></div>
      </div>
    </div>

    <div class="tpanel" id="tp-scale">
      <div class="card">
        <div class="card-hd"><span class="card-num">03</span><span class="card-title">Recipe Scaler</span></div>
        <div class="card-desc">Scale any formula by multiplier, piece count, or yield.</div>
        <label>Scale Method</label>
        <select id="scale-method" onchange="updateScaleMethod()">
          <option value="mult">Multiplier (e.g. ×2)</option>
          <option value="pieces">By Piece Count</option>
          <option value="yield">By Total Yield (g)</option>
        </select>
        <div id="scale-method-inputs"></div>
        <div class="div"><div class="div-lbl">ingredients</div></div>
        <div id="scale-rows"></div>
        <button class="btn btn-ghost btn-sm" onclick="addScaleRow()">+ Add Ingredient</button>
        <button class="btn" style="margin-top:16px" onclick="calcScale()">Scale Recipe</button>
        <div id="scale-res" style="display:none;margin-top:12px">
          <table class="dt" id="scale-table"></table>
          <div style="font-size:10px;color:var(--smoke);margin-top:6px" id="scale-mx"></div>
        </div>
      </div>
    </div>

    <div class="tpanel" id="tp-temp">
      <div class="card">
        <div class="card-hd"><span class="card-num">04</span><span class="card-title">Temperature</span></div>
        <div class="card-desc">°F · °C · Gas Mark conversions</div>
        <div class="preset-row">
          <button class="pbtn sel" id="tb-fc" onclick="setTempMode('fc',this)">°F → °C</button>
          <button class="pbtn" id="tb-cf" onclick="setTempMode('cf',this)">°C → °F</button>
          <button class="pbtn" id="tb-gas" onclick="setTempMode('gas',this)">Gas Mark</button>
        </div>
        <label id="temp-lbl" style="margin-top:12px">Temperature (°F)</label>
        <input type="number" id="temp-in" placeholder="350" step="any"/>
        <button class="btn" onclick="calcTemp()">Convert</button>
        <div id="temp-res" style="display:none">
          <div class="result-grid">
            <div class="result-box hl"><div class="rb-label">Result</div><div class="rb-val" id="temp-out">—</div></div>
            <div class="result-box"><div class="rb-label">Equivalent</div><div class="rb-val" style="font-size:13px;padding-top:4px" id="temp-eq">—</div></div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card-hd"><span class="card-num">—</span><span class="card-title">Oven Reference</span></div>
        <table class="dt"><thead><tr><th>Description</th><th>°F</th><th>°C</th><th class="r">Gas</th></tr></thead><tbody>
          <tr><td>Very Low</td><td>250</td><td>120</td><td class="ac r">½</td></tr>
          <tr><td>Low</td><td>300</td><td>150</td><td class="ac r">2</td></tr>
          <tr><td>Moderate</td><td>350</td><td>175</td><td class="ac r">4</td></tr>
          <tr><td>Hot</td><td>400</td><td>205</td><td class="ac r">6</td></tr>
          <tr><td>Very Hot</td><td>450</td><td>230</td><td class="ac r">8</td></tr>
          <tr><td>Broil</td><td>500+</td><td>260+</td><td class="ac r">9+</td></tr>
        </tbody></table>
      </div>
    </div>

  </div>
</div>

