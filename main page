<script>
// ══ NAVIGATION ═══════════════════════════════════════════════════
const pages=['home','tools','foodcost','prep','waste','tip','comments','blog','about'];
function goTo(id){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.gnav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('page-'+id).classList.add('active');
  const gn=document.getElementById('gn-'+id);
  if(gn)gn.classList.add('active');
  window.scrollTo(0,0);
}
function tt(id,el,page){
  const pg=document.getElementById('page-'+page);
  pg.querySelectorAll('.ttab').forEach(t=>t.classList.remove('active'));
  pg.querySelectorAll('.tpanel').forEach(p=>p.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('tp-'+id).classList.add('active');
}
function toast(msg='Copied!'){
  const t=document.getElementById('toast');
  t.textContent=msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),1800);
}

// ══ UNIT CONVERTER ════════════════════════════════════════════════
const unitSets={
  weight:[{l:'Grams (g)',v:1},{l:'Kilograms (kg)',v:1000},{l:'Ounces (oz)',v:28.3495},{l:'Pounds (lb)',v:453.592}],
  volume:[{l:'Milliliters (ml)',v:1},{l:'Liters (L)',v:1000},{l:'Teaspoons (tsp)',v:4.92892},{l:'Tablespoons (tbsp)',v:14.7868},{l:'Fluid Ounces (fl oz)',v:29.5735},{l:'Cups',v:236.588},{l:'Quarts (qt)',v:946.353},{l:'Gallons (gal)',v:3785.41}]
};
function updateConvUnits(){
  const cat=document.getElementById('conv-cat').value;
  const us=unitSets[cat];
  ['conv-from','conv-to'].forEach((id,i)=>{
    const s=document.getElementById(id);
    s.innerHTML=us.map((u,idx)=>`<option value="${u.v}"${idx===i?' selected':''}>${u.l}</option>`).join('');
  });
  if(cat==='volume')document.getElementById('conv-to').value=unitSets.volume[4].v;
}
updateConvUnits();
function calcConvert(){
  const amt=parseFloat(document.getElementById('conv-amt').value);
  const from=parseFloat(document.getElementById('conv-from').value);
  const to=parseFloat(document.getElementById('conv-to').value);
  if(isNaN(amt)){alert('Enter an amount.');return;}
  const result=(amt*from)/to;
  const fl=document.getElementById('conv-from').selectedOptions[0].text;
  const tl=document.getElementById('conv-to').selectedOptions[0].text;
  document.getElementById('conv-out').textContent=fmt(result);
  document.getElementById('conv-eq').textContent=`${fmt(amt)} ${fl} = ${fmt(result)} ${tl}`;
  show('conv-res');
}

// ══ BAKER'S % ═════════════════════════════════════════════════════
function addFlourRow(n='',w=''){
  const d=mkIngRow(n,w,true);document.getElementById('flour-rows').appendChild(d);
}
function addBkrRow(n='',w=''){
  const d=mkIngRow(n,w,false);document.getElementById('bkr-rows').appendChild(d);
}
function mkIngRow(n,w,isFlour){
  const d=document.createElement('div');d.className='ing-row';
  d.innerHTML=`<input type="text" placeholder="${isFlour?'Flour name':'Ingredient'}" value="${n}" style="font-size:12px;padding:8px 10px"/><input type="number" placeholder="g" value="${w}" step="any" style="font-size:12px;padding:8px 10px"/><div></div><button class="del-btn" onclick="this.parentElement.remove()">×</button>`;
  return d;
}
addFlourRow('Bread Flour');addBkrRow('Water');addBkrRow('Salt');addBkrRow('Starter');
function calcBakers(){
  const fr=document.querySelectorAll('#flour-rows .ing-row');
  const ir=document.querySelectorAll('#bkr-rows .ing-row');
  let tf=0;const rows=[];
  fr.forEach(r=>{const ins=r.querySelectorAll('input');const w=parseFloat(ins[1].value);if(!isNaN(w)&&w>0){tf+=w;rows.push({nm:ins[0].value||'Flour',w,isF:true});}});
  if(!tf){alert('Enter at least one flour weight.');return;}
  ir.forEach(r=>{const ins=r.querySelectorAll('input');const w=parseFloat(ins[1].value);if(!isNaN(w)&&w>0)rows.push({nm:ins[0].value||'Ingredient',w,pct:(w/tf)*100});});
  let html=`<thead><tr><th>Ingredient</th><th>Weight</th><th class="r">Bkr %</th></tr></thead><tbody>`;
  rows.forEach(r=>{const p=r.isF?((r.w/tf)*100).toFixed(1)+'%':r.pct.toFixed(1)+'%';html+=`<tr><td>${esc(r.nm)}</td><td>${fmt(r.w)}g</td><td class="ac r">${p}</td></tr>`;});
  html+=`<tr><td style="color:var(--cream);font-weight:500">Total Flour</td><td style="color:var(--cream)">${fmt(tf)}g</td><td class="ac r" style="font-weight:500">100%</td></tr></tbody>`;
  document.getElementById('bkr-table').innerHTML=html;show('bkr-res');
}

// ══ RECIPE SCALER ═════════════════════════════════════════════════
function updateScaleMethod(){
  const m=document.getElementById('scale-method').value;
  const c=document.getElementById('scale-method-inputs');
  if(m==='mult')c.innerHTML=`<label>Multiplier</label><input type="number" id="sf" placeholder="2" step="any"/>`;
  else if(m==='pieces')c.innerHTML=`<div class="row-2"><div><label>Original Pieces</label><input type="number" id="op" placeholder="14"/></div><div><label>Target Pieces</label><input type="number" id="tp2" placeholder="28"/></div></div>`;
  else c.innerHTML=`<div class="row-2"><div><label>Original Yield (g)</label><input type="number" id="oy" placeholder="1000"/></div><div><label>Target Yield (g)</label><input type="number" id="ty" placeholder="2000"/></div></div>`;
}
updateScaleMethod();
function addScaleRow(n='',w=''){
  const d=document.createElement('div');d.className='ing-row';
  d.innerHTML=`<input type="text" placeholder="Ingredient" value="${n}" style="font-size:12px;padding:8px 10px"/><input type="number" placeholder="g" value="${w}" step="any" style="font-size:12px;padding:8px 10px"/><div></div><button class="del-btn" onclick="this.parentElement.remove()">×</button>`;
  document.getElementById('scale-rows').appendChild(d);
}
addScaleRow();addScaleRow();addScaleRow();
function calcScale(){
  const m=document.getElementById('scale-method').value;
  let mx=1;
  if(m==='mult'){mx=parseFloat(document.getElementById('sf').value);}
  else if(m==='pieces'){const o=parseFloat(document.getElementById('op').value),t=parseFloat(document.getElementById('tp2').value);if(!o||!t){alert('Enter both counts.');return;}mx=t/o;}
  else{const o=parseFloat(document.getElementById('oy').value),t=parseFloat(document.getElementById('ty').value);if(!o||!t){alert('Enter both yields.');return;}mx=t/o;}
  if(isNaN(mx)||mx<=0){alert('Invalid values.');return;}
  const rows=document.querySelectorAll('#scale-rows .ing-row');
  let html=`<thead><tr><th>Ingredient</th><th>Original</th><th class="r">Scaled</th></tr></thead><tbody>`;
  let ok=false;
  rows.forEach(r=>{const ins=r.querySelectorAll('input');const w=parseFloat(ins[1].value);if(!isNaN(w)&&w>0){ok=true;html+=`<tr><td>${esc(ins[0].value||'Ingredient')}</td><td>${fmt(w)}g</td><td class="ac r">${fmt(w*mx)}g</td></tr>`;}});
  if(!ok){alert('Enter at least one ingredient.');return;}
  html+='</tbody>';
  document.getElementById('scale-table').innerHTML=html;
  document.getElementById('scale-mx').textContent=`Scale factor: ×${mx.toFixed(4).replace(/\.?0+$/,'')}`;
  show('scale-res');
}

// ══ TEMPERATURE ════════════════════════════════════════════════════
let tMode='fc';
const gasM=[[1,275,135],[2,300,150],[3,325,165],[4,350,175],[5,375,190],[6,400,205],[7,425,220],[8,450,230],[9,475,245]];
function setTempMode(m,el){
  tMode=m;
