function buildBlog(){
  const container=document.getElementById('blog-cards');
  container.innerHTML='';
  posts.forEach((p,i)=>{
    const d=document.createElement('div');d.className='blog-card';
    d.innerHTML=`<div class="blog-tag">${p.tag}</div><div class="blog-title">${p.title}</div><div class="blog-excerpt">${p.excerpt}</div><div class="blog-meta"><span class="blog-date">${p.date} · ${p.readTime}</span><span class="blog-read">Read →</span></div>`;
    d.onclick=()=>showPost(i);
    container.appendChild(d);
  });
}
function showPost(idx){
  const p=posts[idx];
  document.getElementById('post-tag').textContent=p.tag;
  document.getElementById('post-title').textContent=p.title;
  document.getElementById('post-meta').textContent=p.date+' · '+p.readTime;
  document.getElementById('post-body').innerHTML=p.body;
  const toolsEl=document.getElementById('post-tools');
  toolsEl.innerHTML='';
  p.tools.forEach(t=>{
    const d=document.createElement('div');
    d.className='lcard';d.style.marginBottom='8px';
    d.innerHTML=`<div class="lcard-icon">🍴</div><div class="lcard-body"><span class="lcard-title" style="font-size:14px">${t.label}</span></div><span class="lcard-arrow">→</span>`;
    d.onclick=()=>goTo(t.page);
    toolsEl.appendChild(d);
  });
  document.getElementById('blog-list-view').style.display='none';
  const pv=document.getElementById('blog-post-view');
  pv.style.display='block';pv.classList.add('active');
  window.scrollTo(0,0);
}
function showBlogList(){
  document.getElementById('blog-list-view').style.display='block';
  const pv=document.getElementById('blog-post-view');
  pv.style.display='none';pv.classList.remove('active');
  window.scrollTo(0,0);
}

