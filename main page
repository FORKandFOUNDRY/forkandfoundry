function calcFC(){
  const portions=parseFloat(document.getElementById('fc-portions').value);
  if(!portions||portions<1){alert('Enter number of portions.');return;}
  const rows=document.querySelectorAll('#fc-rows .ing-row');
  let total=0;const items=[];let ok=false;
  rows.forEach(r=>{
    const ins=r.querySelectorAll('input');
    const nm=ins[0].value||'Ingredient';
    const cost=parseFloat(ins[1].value);
    const pct=parseFloat(ins[2].value)/100||1;
    if(!isNaN(cost)&&cost>0){ok=true;const used=cost*pct;total+=used;items.push({nm,cost,pctD:Math.round(pct*100),used});}
  });
  if(!ok){alert('Enter at least one ingredient cost.');return;}
  const per=total/portions;
  document.getElementById('fc-total').textContent='$'+total.toFixed(2);
  document.getElementById('fc-per').textContent='$'+per.toFixed(2);
  let html=`<thead><tr><th>Ingredient</th><th>Unit Cost</th><th>Used</th><th class="r">Cost</th></tr></thead><tbody>`;
  items.forEach(i=>html+=`<tr><td>${esc(i.nm)}</td><td>$${i.cost.toFixed(2)}</td><td>${i.pctD}%</td><td class="ac r">$${i.used.toFixed(2)}</td></tr>`);
  html+=`<tr><td colspan="3" style="color:var(--cream);font-weight:500">Total · ${portions} portions</td><td class="ac r" style="font-weight:500">$${total.toFixed(2)}</td></tr>`;
  html+=`<tr><td colspan="3" style="color:var(--cream)">Cost Per Portion</td><td class="ac r">$${per.toFixed(2)}</td></tr></tbody>`;
  document.getElementById('fc-breakdown').innerHTML=html;show('fc-res');
}
const cT={fine:{lo:25,hi:28},casual:{lo:28,hi:32},bar:{lo:32,hi:38},fast:{lo:28,hi:35}};
function setFCP(v,el){document.getElementById('mp-target').value=v;document.querySelectorAll('#tp-fc-menu .pbtn').forEach(b=>b.classList.remove('sel'));el.classList.add('sel');}
function clearFCP(){document.querySelectorAll('#tp-fc-menu .pbtn').forEach(b=>b.classList.remove('sel'));}
function calcMP(){
  const cost=parseFloat(document.getElementById('mp-cost').value);
  const target=parseFloat(document.getElementById('mp-target').value)/100;
  if(isNaN(cost)||cost<=0){alert('Enter cost per portion.');return;}
  if(isNaN(target)||target<=0){alert('Enter a target food cost %.');return;}
  const price=cost/target;
  const profit=price-cost;
  const fcPct=(cost/price)*100;
  document.getElementById('mp-price').textContent='$'+price.toFixed(2);
  document.getElementById('mp-profit').textContent='$'+profit.toFixed(2);
  setGauge('mp-gauge','mp-glbl',fcPct);
  showVerdict('mp-v','mp-vl','mp-vt',fcPct,'casual');
  show('mp-res');
}
function calcMC(){
  const price=parseFloat(document.getElementById('mc-price').value);
  const cost=parseFloat(document.getElementById('mc-cost').value);
  const labor=parseFloat(document.getElementById('mc-labor').value)||0;
  const overhead=parseFloat(document.getElementById('mc-overhead').value)||0;
  const concept=document.getElementById('mc-concept').value;
  if(isNaN(price)||price<=0){alert('Enter menu price.');return;}
  if(isNaN(cost)||cost<=0){alert('Enter ingredient cost.');return;}
  const fcPct=(cost/price)*100;
  const gp=price-cost;
  const gpPct=(gp/price)*100;
  const net=price-cost-labor-overhead;
  const primePct=((cost+labor)/price)*100;
  const fcEl=document.getElementById('mc-fc');
  fcEl.textContent=fcPct.toFixed(1)+'%';
  const t=cT[concept];
  fcEl.classList.remove('c-good','c-warn','c-bad');
  if(fcPct<=t.hi)fcEl.classList.add('c-good');else if(fcPct<=t.hi+6)fcEl.classList.add('c-warn');else fcEl.classList.add('c-bad');
  document.getElementById('mc-gp').textContent='$'+gp.toFixed(2);
  document.getElementById('mc-gp-sub').textContent=gpPct.toFixed(1)+'% gross margin';
  setGauge('mc-gauge','mc-glbl',fcPct);
  showVerdict('mc-v','mc-vl','mc-vt',fcPct,concept);
  if(labor>0){document.getElementById('mc-pp').textContent=primePct.toFixed(1)+'%';document.getElementById('mc-net').textContent='$'+net.toFixed(2);show('mc-prime');}
  else document.getElementById('mc-prime').style.display='none';
  show('mc-res');
}
function setGauge(fillId,lblId,pct){
  const f=document.getElementById(fillId);
  f.style.width=Math.min((pct/60)*100,100)+'%';
  f.style.background=pct<=28?'var(--green)':pct<=35?'var(--yellow)':'var(--red)';
  document.getElementById(lblId).textContent=pct.toFixed(1)+'%';
}
function showVerdict(wId,lId,tId,pct,concept){
  const wrap=document.getElementById(wId);
  const t=cT[concept]||cT.casual;
  wrap.classList.remove('v-good','v-warn','v-bad','show');
  let cls,lbl,msg;
  if(pct<t.lo){cls='v-good';lbl='✓ Strong Margin';msg=`Your food cost of ${pct.toFixed(1)}% is below target. Solid margin — make sure quality isn't being cut to hit that number.`;}
  else if(pct<=t.hi){cls='v-good';lbl='✓ On Target';msg=`${pct.toFixed(1)}% is right in the target range. Keep the system tight and the margin holds.`;}
  else if(pct<=t.hi+6){cls='v-warn';lbl='⚠ Slightly High';msg=`${pct.toFixed(1)}% is above your target. Review portion sizes, prep yield, waste, and supplier costs.`;}
  else{cls='v-bad';lbl='✕ Needs Attention';msg=`${pct.toFixed(1)}% is significantly above target. Audit your recipe costs, portions, purchasing, and waste tracking immediately.`;}
  wrap.classList.add(cls,'show');
  document.getElementById(lId).textContent=lbl;
  document.getElementById(tId).textContent=msg;
}

