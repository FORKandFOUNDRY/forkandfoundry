        <div style="display:grid;grid-template-columns:1fr 80px 68px 28px;gap:6px;margin-bottom:5px">
          <span style="font-size:8px;letter-spacing:0.13em;text-transform:uppercase;color:var(--smoke)">Ingredient</span>
          <span style="font-size:8px;letter-spacing:0.13em;text-transform:uppercase;color:var(--smoke)">Cost ($)</span>
          <span style="font-size:8px;letter-spacing:0.13em;text-transform:uppercase;color:var(--smoke)">Used %</span>
          <span></span>
        </div>
        <div id="fc-rows"></div>
        <button class="btn btn-ghost btn-sm" onclick="addFCRow()">+ Add Ingredient</button>
        <button class="btn" onclick="calcFC()">Calculate Recipe Cost</button>
        <div id="fc-res" style="display:none">
          <div class="result-grid">
            <div class="result-box hl"><div class="rb-label">Total Cost</div><div class="rb-val" id="fc-total">—</div></div>
            <div class="result-box hl"><div class="rb-label">Cost / Portion</div><div class="rb-val" id="fc-per">—</div></div>
          </div>
          <table class="dt" id="fc-breakdown"></table>
        </div>
      </div>
    </div>

    <div class="tpanel" id="tp-fc-menu">
      <div class="card">
        <div class="card-hd"><span class="card-num">02</span><span class="card-title">Menu Price Calculator</span></div>
        <div class="card-desc">Enter cost per portion + target FC% to get recommended menu price and gross profit.</div>
        <label>Cost Per Portion ($)</label>
        <input type="number" id="mp-cost" placeholder="4.50" step="0.01" min="0"/>
        <label>Target Food Cost %</label>
        <div class="preset-row">
          <button class="pbtn" onclick="setFCP(25,this)">25%<br/><span style="font-size:7px;opacity:0.7">Fine Dining</span></button>
          <button class="pbtn" onclick="setFCP(30,this)">30%<br/><span style="font-size:7px;opacity:0.7">Casual</span></button>
          <button class="pbtn" onclick="setFCP(35,this)">35%<br/><span style="font-size:7px;opacity:0.7">Bar / Pub</span></button>
        </div>
        <div style="display:flex;align-items:center;gap:8px;margin-top:8px">
          <input type="number" id="mp-target" placeholder="Custom %" step="0.1" min="1" max="99" style="flex:1" oninput="clearFCP()"/>
          <span style="font-size:12px;color:var(--ash)">%</span>
        </div>
        <label>Labor / Portion ($) <span style="opacity:0.5">optional</span></label>
        <input type="number" id="mp-labor" placeholder="1.50" step="0.01" min="0"/>
        <button class="btn" onclick="calcMP()">Calculate Menu Price</button>
        <div id="mp-res" style="display:none">
          <div class="result-grid">
            <div class="result-box hl"><div class="rb-label">Recommended Price</div><div class="rb-val" id="mp-price">—</div><div class="rb-sub">at target FC%</div></div>
            <div class="result-box hl"><div class="rb-label">Gross Profit</div><div class="rb-val" id="mp-profit">—</div><div class="rb-sub">per portion</div></div>
          </div>
          <div class="gauge-wrap">
            <div class="gauge-row"><span class="gauge-lbl">Food Cost %</span><span class="gauge-val" id="mp-glbl">—</span></div>
            <div class="gauge-track"><div class="gauge-fill" id="mp-gauge"></div></div>
            <div class="gauge-zones"><span>0%</span><span style="color:var(--green)">25%</span><span style="color:var(--yellow)">35%</span><span>50%+</span></div>
          </div>
          <div class="verdict" id="mp-v"><div class="verdict-lbl" id="mp-vl"></div><div class="verdict-txt" id="mp-vt"></div></div>
        </div>
      </div>
    </div>

    <div class="tpanel" id="tp-fc-margin">
      <div class="card">
        <div class="card-hd"><span class="card-num">03</span><span class="card-title">Margin Check</span></div>
        <div class="card-desc">Enter your current menu price and costs. Get real FC%, gross profit, and a verdict.</div>
        <div class="row-2">
          <div><label>Menu Price ($)</label><input type="number" id="mc-price" placeholder="18.00" step="0.01" min="0"/></div>
          <div><label>Ingredient Cost ($)</label><input type="number" id="mc-cost" placeholder="5.40" step="0.01" min="0"/></div>
        </div>
        <div class="row-2">
          <div><label>Labor / Portion ($) <span style="opacity:0.5">opt</span></label><input type="number" id="mc-labor" placeholder="2.00" step="0.01" min="0"/></div>
          <div><label>Overhead / Portion ($) <span style="opacity:0.5">opt</span></label><input type="number" id="mc-overhead" placeholder="1.00" step="0.01" min="0"/></div>
        </div>
        <label>Concept Type</label>
        <select id="mc-concept">
          <option value="fine">Fine Dining — target 25–28%</option>
          <option value="casual" selected>Casual / Full Service — target 28–32%</option>
          <option value="bar">Bar / Pub — target 32–38%</option>
          <option value="fast">Fast Casual — target 28–35%</option>
        </select>
        <button class="btn" onclick="calcMC()">Check My Margins</button>
        <div id="mc-res" style="display:none">
          <div class="result-grid">
            <div class="result-box"><div class="rb-label">Food Cost %</div><div class="rb-val" id="mc-fc">—</div></div>
            <div class="result-box"><div class="rb-label">Gross Profit</div><div class="rb-val" id="mc-gp">—</div><div class="rb-sub" id="mc-gp-sub"></div></div>
          </div>
          <div class="gauge-wrap">
            <div class="gauge-row"><span class="gauge-lbl">Food Cost %</span><span class="gauge-val" id="mc-glbl">—</span></div>
            <div class="gauge-track"><div class="gauge-fill" id="mc-gauge"></div></div>
            <div class="gauge-zones"><span>0%</span><span style="color:var(--green)">25%</span><span style="color:var(--yellow)">35%</span><span>50%+</span></div>
          </div>
          <div class="verdict" id="mc-v"><div class="verdict-lbl" id="mc-vl"></div><div class="verdict-txt" id="mc-vt"></div></div>
          <div id="mc-prime" style="display:none">
            <div class="div"><div class="div-lbl">prime cost</div></div>
            <div class="result-grid">
              <div class="result-box"><div class="rb-label">Prime Cost %</div><div class="rb-val" id="mc-pp">—</div><div class="rb-sub">Food + Labor</div></div>
              <div class="result-box"><div class="rb-label">Net Margin</div><div class="rb-val" id="mc-net">—</div><div class="rb-sub">After all costs</div></div>
            </div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card-hd"><span class="card-num">—</span><span class="card-title">Industry Benchmarks</span></div>
        <table class="dt"><thead><tr><th>Concept</th><th>Food Cost</th><th class="r">Prime Cost</th></tr></thead><tbody>
          <tr><td>Fine Dining</td><td>25–28%</td><td class="ac r">55–60%</td></tr>
          <tr><td>Casual Dining</td><td>28–32%</td><td class="ac r">55–65%</td></tr>
          <tr><td>Bar / Pub</td><td>32–38%</td><td class="ac r">60–65%</td></tr>
          <tr><td>Fast Casual</td><td>28–35%</td><td class="ac r">55–65%</td></tr>
          <tr><td>Catering</td><td>25–35%</td><td class="ac r">50–60%</td></tr>
        </tbody></table>
      </div>
    </div>

  </div>
</div>

