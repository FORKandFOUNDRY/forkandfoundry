function copyCB(id,el){
  const text=cbMap[id];if(!text)return;
  const copy=()=>{el.style.borderColor='var(--green)';toast('Copied!');setTimeout(()=>el.style.borderColor='var(--border)',2000);};
  if(navigator.clipboard)navigator.clipboard.writeText(text).then(copy).catch(()=>fbCopy(text,copy));
  else fbCopy(text,copy);
}
function fbCopy(text,cb){
  const ta=document.createElement('textarea');ta.value=text;ta.style.cssText='position:fixed;opacity:0';
  document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);cb();
}

