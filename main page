        <div class="card-desc">Add ingredients with purchase cost and % used per recipe. Get total and cost per portion.</div>
        <div class="row-2">
          <div><label>Recipe Name</label><input type="text" id="fc-name" placeholder="e.g. Focaccia"/></div>
          <div><label>Portions Yielded</label><input type="number" id="fc-portions" placeholder="12" step="1" min="1"/></div>
