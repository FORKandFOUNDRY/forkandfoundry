<div class="page" id="page-prep">
  <div class="page-hdr">
    <div class="hdr-rule"><div class="hdr-line"></div><span style="color:var(--ember);font-size:13px">🍴</span><div class="hdr-line r"></div></div>
    <div class="brand">Prep List</div>
    <div class="brand-sub">Fork &amp; Foundry · Run a Clean Service</div>
