function calcTemp(){
  const v=parseFloat(document.getElementById('temp-in').value);
  if(isNaN(v)){alert('Enter a temperature.');return;}
  let out,eq;
  if(tMode==='fc'){const c=(v-32)*5/9;out=`${fmt(c)}°C`;eq=`${v}°F = ${fmt(c)}°C`;}
  else if(tMode==='cf'){const f=v*9/5+32;out=`${fmt(f)}°F`;eq=`${v}°C = ${fmt(f)}°F`;}
  else{const g=Math.round(Math.max(1,Math.min(9,v)));const r=gasM.find(x=>x[0]===g)||gasM[8];out=`${r[1]}°F / ${r[2]}°C`;eq=`Gas Mark ${g} ≈ ${r[1]}°F / ${r[2]}°C`;}
  document.getElementById('temp-out').textContent=out;
  document.getElementById('temp-eq').textContent=eq;
  show('temp-res');
}

